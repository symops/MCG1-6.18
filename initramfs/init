#!/bin/sh
# MCG1 rescue initramfs init.
#
# This is NOT the board's normal boot path (the shipped Devuan/Debian
# rootfs boots directly via barebox, no initrd involved). This uRamdisk
# is an alternate, optional path wired to partition 6 of the SATA disk
# (see BUILDING.md section 9) for testing/recovery without touching the
# real boot setup.
#
# This image IS the rootfs -- it does not mount and switch_root into
# the board's real Debian/Devuan install. It just brings up the
# hardware and drops to an interactive busybox shell, so the real
# rootfs on /dev/md0 can be inspected/repaired manually (fsck, mount
# read-only, etc.) without any risk of this script itself writing to
# it or chain-booting into it.
#
# AHCI SATA, software RAID and ext4 are all built into the kernel
# (=y in ls1024a_defconfig), so they need no insmod here. But three
# other drivers this board actually needs are built as modules
# (=m), the same way pelican/monarch need their own insmod set:
#   - phy-ls1024a-serdes.ko: SerDes PHY, needed for the physical
#     SATA/USB3 link to come up at all, even with AHCI built in.
#   - usb-storage.ko / uas.ko: USB mass-storage support, for booting
#     this rescue image off a USB drive as a recovery path.

mkdir -p /proc /sys /dev /mnt/root
mount -t proc proc /proc
mount -t sysfs sysfs /sys
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	mdev -s
fi

echo ""
echo "=== MCG1 rescue initramfs ==="
echo ""

insmod /lib/modules/phy-ls1024a-serdes.ko 2>&1 || echo "warning: insmod phy-ls1024a-serdes.ko failed"
insmod /lib/modules/usb-storage.ko 2>&1 || echo "warning: insmod usb-storage.ko failed"
insmod /lib/modules/uas.ko 2>&1 || echo "warning: insmod uas.ko failed"

# The board's real root filesystem is a software RAID1 array at
# /dev/md0 (see README.md: "md0 (the RAID1 rootfs) assembles and
# mounts"). md1/md2 are other arrays on this board whose purpose has
# not been established in this project -- this script does not touch
# them. Assembling it here (but not mounting/switch_root'ing into it)
# just makes /dev/md0 available for the operator to mount by hand from
# the shell below, if they want to.
if [ -x /sbin/mdadm ]; then
	/sbin/mdadm --assemble --scan 2>&1
else
	echo "mdadm not present in this image; relying on kernel MD_AUTODETECT"
fi

echo ""
echo "=== Rescue shell ==="
echo ""
exec /bin/sh
