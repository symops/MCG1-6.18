// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include <dt-bindings/clock/ls1024a.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include "ls1024a.dtsi"

/ {
	model = "Western Digital My Cloud (Gen 1)";
	compatible = "wdc,mycloud-gen1", "fsl,ls1024a";

	chosen {
		bootargs = "console=ttyS0,115200n8 earlyprintk";
		stdout-path = &uart1;
	};

	/*
	 * Both LEDs are plain GPIO output bits on the SoC's own GPIO
	 * controller (drivers/leds/leds-wd.c in the 3.2.26 vendor tree
	 * drives them by poking COMCERTO_GPIO_OUTPUT_REG directly, at the
	 * same bit positions gpio-ls1024a.c already exposes as GPIO lines
	 * 5-7 and 12-13 -- 1 = LED on, matching GPIO_ACTIVE_HIGH). No
	 * pinmux group is needed: the vendor board init code never
	 * switches these pins away from GPIO by default (only the
	 * currently-unported PWM breathing/pulse mode does, via
	 * COMCERTO_GPIO_PIN_SELECT_REG).
	 */
	system_leds: system-leds {
		compatible = "gpio-leds";

		led_system_red: led-0 {
			gpios = <&gpio 7 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
		};

		led_system_green: led-1 {
			gpios = <&gpio 5 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};

		led_system_blue: led-2 {
			gpios = <&gpio 6 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
		};
	};

	system_led: multi-led-0 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_STATUS;
		leds = <&led_system_red>, <&led_system_green>, <&led_system_blue>;
	};

	/*
	 * wifi_led is two separately-colored LEDs (not R/G/B primaries),
	 * combined the same way the vendor driver did for its "white"
	 * state (both on at once) -- LED_COLOR_ID_MULTI rather than
	 * LED_COLOR_ID_RGB since these aren't RGB primaries.
	 */
	wifi_leds: wifi-leds {
		compatible = "gpio-leds";

		led_wifi_yellow: led-0 {
			gpios = <&gpio 12 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_WLAN;
		};

		led_wifi_blue: led-1 {
			gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
		};
	};

	wifi_led: multi-led-1 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_MULTI>;
		function = LED_FUNCTION_WLAN;
		leds = <&led_wifi_yellow>, <&led_wifi_blue>;
	};
};

&uart1 {
	status = "okay";
};

&sata {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_phy {
	status = "okay";
};

&pfe {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * Stage P7 (see Documentation/arm/ls1024a-wdmycloud.rst): GEM0
	 * only, for now. PHY address 0 confirmed on real hardware -- the
	 * mdio bus's full address scan (pfe_eth.c, added specifically
	 * because this address was unconfirmed) found exactly one PHY
	 * responding, at address 0 (id 0362:5e6a), matching the only real
	 * data point in the GPL source drop (a hand-edited comment in the
	 * old board-c2kevm.c crossing out phy_id=4 for phy_id=0 and
	 * identifying a Broadcom PHY).
	 */
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		phy0: ethernet-phy@0 {
			reg = <0>;
		};
	};

	gem0: ethernet@0 {
		compatible = "fsl,ls1024a-pfe-gem";
		reg = <0>;
		phy-mode = "rgmii-id";
		phy-handle = <&phy0>;
		/*
		 * Confirmed required on real hardware (see the "MDIO stops
		 * working ~1s after boot" writeup in
		 * Documentation/arm/ls1024a-wdmycloud.rst): a per-GEM 125MHz
		 * clock line, distinct from the pfe node's shared "gemtx".
		 * Without it, the kernel's own "disabling unused clocks" late
		 * boot step gates this line off shortly after boot (nothing
		 * had ever requested it), and every MDIO read past that point
		 * silently returns stale data instead of erroring.
		 */
		clocks = <&clkcore LS1024A_CLK_EXTPHY0>;
		clock-names = "extphy";
	};
};

&ls_spi {
	status = "okay";
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi &pinctrl_spi_ss0>;
	/delete-property/ interrupts;

	/*
	 * This controller's EEPROM-read (TMOD_EPROMREAD) hardware mode only
	 * ever clocks in the first data byte of a multi-byte read, then
	 * stops. With this set, dw_spi_exec_mem_op() falls back to plain
	 * full-duplex (TMOD_TR) and manually drives the read phase's clock
	 * with dummy Tx bytes instead. See
	 * Documentation/arm/ls1024a-wdmycloud.rst for the full derivation.
	 */
	snps,dwc-ssi-broken-eeprom-read;

	/*
	 * This block was never taken out of hardware reset otherwise.
	 * LS1024A_AXI_DUS_RST is the reset line for this controller's "dus"
	 * clock domain.
	 */
	resets = <&clkreset LS1024A_AXI_DUS_RST>;
	reset-names = "spi";

	/*
	 * Boot/env SPI-NOR flash (also used by barebox for its own
	 * environment storage). barebox's board file calls this
	 * "S25FL064A" (Spansion, 8 MiB), but that's a stale vendor device
	 * name -- read on real hardware, the actual JEDEC ID is
	 * 0xef 0x30 0x13, an exact match for "w25x40" (Winbond, 512 KiB).
	 * Mode (SPI_CPOL | SPI_CPHA) and frequency (4 MHz) copied from
	 * barebox's spi_board_info entry and confirmed correct.
	 */
	flash@0 {
		compatible = "winbond,w25x40", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <4000000>;
		spi-cpha;
		spi-cpol;
	};
};

&hs_spi {
	status = "okay";
};

&i2c {
	status = "okay";
};

/*
 * Not yet ported (Stage 2+):
 *  - PFE (Comcerto Packet Forwarding Engine): no mainline or Bonstra/
 *    linux-ls1024a driver exists for this block, so this fork ports one
 *    from scratch (see the &pfe node above and
 *    Documentation/arm/ls1024a-wdmycloud.rst's Stage P1-P10 log) --
 *    in progress, staged: GEM0's net_device/MDIO/PHY skeleton exists
 *    (Stage P7) but doesn't pass traffic yet (Stage P8), and GEM1/GEM2
 *    aren't wired up at all yet (Stage P9). Reference for all of this is
 *    the old 3.2.26 kernel's custom "pfe" module (see the imported
 *    kmodules/mspd-c2k/pfe sources and firmware blobs in
 *    symops/MCG1-3.2.26).
 *  - RTC (c2k-rtc): proprietary Mindspeed block, no driver in mainline
 *    or in this fork. Board has no RTC backup battery, so NTP-only
 *    timekeeping is the permanent behavior here, not a gap.
 *  - Board LED breathing/pulse effect: the vendor driver's "pulse"
 *    mode drives these LEDs through hardware PWM1-3 instead of plain
 *    GPIO (see system_leds/wifi_leds above for the plain on/off
 *    support, which is wired up). No LS1024A PWM driver exists yet in
 *    this fork, so only software-side blink (via LED triggers) is
 *    available for now, not the smooth hardware pulse. (This board
 *    has no fan, unlike some other SKUs sharing the vendor image.)
 *  - PCIe (pcie0/pcie1, inherited disabled from ls1024a.dtsi): PCIe0
 *    reported "Link Up Failed" in the old kernel's boot log -- nothing
 *    is physically connected on this board.
 */
