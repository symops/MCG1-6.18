// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include "ls1024a.dtsi"

/ {
	model = "Western Digital My Cloud (Gen 1)";
	compatible = "wdc,mycloud-gen1", "fsl,ls1024a";

	chosen {
		bootargs = "console=ttyS0,115200n8 earlyprintk";
		stdout-path = &uart1;
	};
};

&uart1 {
	status = "okay";
};

&sata {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_phy {
	status = "okay";
};

&ls_spi {
	status = "okay";
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi &pinctrl_spi_ss0>;

	/*
	 * Force polling mode (see spi-dw-mmio.c's platform_get_irq_optional
	 * patch): this device is wired to the controller's *native*
	 * (register-based) chip-select, and drivers/spi/spi-dw-core.c's own
	 * dw_spi_poll_transfer() comment documents that IRQ-driven transfers
	 * don't work reliably with native CS, due to automatic assert/
	 * de-assert timing. Confirmed on real hardware: with an interrupts
	 * property present, the flash@0 probe below hangs solid (no oops,
	 * no panic) every time, right as the first real transaction starts.
	 * barebox's own SPI driver for this exact chip (drivers/spi/
	 * c2k_spi.c in the vendor barebox-2011.06.0 GPL source) is
	 * poll-only and never used a GPIO chip-select either -- confirming
	 * native CS + polling is the combination this hardware actually
	 * wants, not a GPIO-CS workaround.
	 */
	/delete-property/ interrupts;

	/*
	 * Boot/env SPI-NOR flash (also used by barebox itself, per
	 * `devinfo` on real hardware: "c2k_spi0" -> "S25FL064A0", and by
	 * name in barebox's own board file: arch/arm/boards/comcerto-asic/
	 * c2k_asic.c, "S25FL064A", chip_select 0). Spansion/Cypress
	 * S25FL064A, 8 MiB, matches upstream spi-nor's "s25sl064a" entry
	 * (3-byte JEDEC ID 01 02 16, no SFDP/quad support -- an old, plain
	 * chip). Mode (SPI_CPOL | SPI_CPHA, i.e. mode 3) and frequency
	 * (4 MHz) copied directly from that same barebox board file's
	 * spi_board_info entry for this chip.
	 */
	flash@0 {
		compatible = "spansion,s25sl064a", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <4000000>;
		spi-cpha;
		spi-cpol;
	};
};

&hs_spi {
	status = "okay";
};

&i2c {
	status = "okay";
};

/*
 * Not yet ported (Stage 2+):
 *  - PFE (Comcerto Packet Forwarding Engine / eth0): no mainline or
 *    Bonstra/linux-ls1024a driver exists for this block yet. The old
 *    3.2.26 kernel used a custom "pfe" module (see the imported
 *    kmodules/mspd-c2k/pfe sources and firmware blobs in
 *    symops/MCG1-3.2.26) driving EMAC1-3/EGPI/HGPI/BMU/CLASS/TMU/UTIL/HIF.
 *  - RTC (c2k-rtc): proprietary Mindspeed block, no driver in mainline
 *    or in this fork. Board boots with NTP-only timekeeping for now.
 *  - Board LEDs (system_led RGB via GPIO 5/6/7, wifi_led via GPIO 12/13):
 *    the old kernel drove these with direct register pokes
 *    (drivers/leds/leds-wd.c in the 3.2.26 tree), not through
 *    gpio-leds. No LS1024A PWM driver exists yet in this fork, and
 *    the RGB LED combining logic doesn't map cleanly onto plain
 *    gpio-leds. Left out of this DTS rather than describing hardware
 *    with no driver behind it. (This board has no fan.)
 *  - PCIe (pcie0/pcie1, inherited disabled from ls1024a.dtsi): PCIe0
 *    reported "Link Up Failed" in the old kernel's boot log -- nothing
 *    is physically connected on this board.
 */
