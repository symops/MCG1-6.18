// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include "ls1024a.dtsi"

/ {
	model = "Western Digital My Cloud (Gen 1)";
	compatible = "wdc,mycloud-gen1", "fsl,ls1024a";

	chosen {
		bootargs = "console=ttyS0,115200n8 earlyprintk";
		stdout-path = &uart1;
	};
};

&uart1 {
	status = "okay";
};

&sata {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_phy {
	status = "okay";
};

&ls_spi {
	status = "okay";
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi &pinctrl_spi_ss0>;
	/delete-property/ interrupts;

	/*
	 * This controller's EEPROM-read (TMOD_EPROMREAD) hardware mode only
	 * ever clocks in the first data byte of a multi-byte read, then
	 * stops. With this set, dw_spi_exec_mem_op() falls back to plain
	 * full-duplex (TMOD_TR) and manually drives the read phase's clock
	 * with dummy Tx bytes instead. See
	 * Documentation/arm/ls1024a-wdmycloud.rst for the full derivation.
	 */
	snps,dwc-ssi-broken-eeprom-read;

	/*
	 * This block was never taken out of hardware reset otherwise.
	 * LS1024A_AXI_DUS_RST is the reset line for this controller's "dus"
	 * clock domain.
	 */
	resets = <&clkreset LS1024A_AXI_DUS_RST>;
	reset-names = "spi";

	/*
	 * Boot/env SPI-NOR flash (also used by barebox for its own
	 * environment storage). barebox's board file calls this
	 * "S25FL064A" (Spansion, 8 MiB), but that's a stale vendor device
	 * name -- read on real hardware, the actual JEDEC ID is
	 * 0xef 0x30 0x13, an exact match for "w25x40" (Winbond, 512 KiB).
	 * Mode (SPI_CPOL | SPI_CPHA) and frequency (4 MHz) copied from
	 * barebox's spi_board_info entry and confirmed correct.
	 */
	flash@0 {
		compatible = "winbond,w25x40", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <4000000>;
		spi-cpha;
		spi-cpol;
	};
};

&hs_spi {
	status = "okay";
};

&i2c {
	status = "okay";
};

/*
 * Not yet ported (Stage 2+):
 *  - PFE (Comcerto Packet Forwarding Engine / eth0): no mainline or
 *    Bonstra/linux-ls1024a driver exists for this block yet. The old
 *    3.2.26 kernel used a custom "pfe" module (see the imported
 *    kmodules/mspd-c2k/pfe sources and firmware blobs in
 *    symops/MCG1-3.2.26) driving EMAC1-3/EGPI/HGPI/BMU/CLASS/TMU/UTIL/HIF.
 *  - RTC (c2k-rtc): proprietary Mindspeed block, no driver in mainline
 *    or in this fork. Board boots with NTP-only timekeeping for now.
 *  - Board LEDs (system_led RGB via GPIO 5/6/7, wifi_led via GPIO 12/13):
 *    the old kernel drove these with direct register pokes
 *    (drivers/leds/leds-wd.c in the 3.2.26 tree), not through
 *    gpio-leds. No LS1024A PWM driver exists yet in this fork, and
 *    the RGB LED combining logic doesn't map cleanly onto plain
 *    gpio-leds. Left out of this DTS rather than describing hardware
 *    with no driver behind it. (This board has no fan.)
 *  - PCIe (pcie0/pcie1, inherited disabled from ls1024a.dtsi): PCIe0
 *    reported "Link Up Failed" in the old kernel's boot log -- nothing
 *    is physically connected on this board.
 */
