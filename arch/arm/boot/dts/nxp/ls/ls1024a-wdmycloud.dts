// SPDX-License-Identifier: GPL-2.0
/dts-v1/;
#include "ls1024a.dtsi"

/ {
	model = "Western Digital My Cloud (Gen 1)";
	compatible = "wdc,mycloud-gen1", "fsl,ls1024a";

	chosen {
		bootargs = "console=ttyS0,115200n8 earlyprintk";
		stdout-path = &uart1;
	};
};

&uart1 {
	status = "okay";
};

&sata {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_phy {
	status = "okay";
};

&ls_spi {
	status = "okay";
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_spi &pinctrl_spi_ss0>;
	/delete-property/ interrupts;

	/*
	 * This controller's EEPROM-read (TMOD_EPROMREAD) hardware mode
	 * only ever clocks in the first data byte of a multi-byte read,
	 * then stops -- confirmed via register-level tracing (Rx FIFO
	 * genuinely never refills after byte 1, for millions of poll
	 * iterations) against a 6-byte JEDEC READ ID.
	 *
	 * Falling back to the classic spi_sync()-based path doesn't work
	 * either: it issues the command and data as two separate
	 * ->transfer_one() calls, and this controller's native chip
	 * select auto-releases as soon as the Tx FIFO empties between
	 * them (confirmed: the transfer completes with no hang, but the
	 * chip returns all-zero garbage -- CS glitched mid-command).
	 *
	 * With this set, dw_spi_exec_mem_op() uses plain full-duplex
	 * (TMOD_TR) instead of EEPROM-read, and manually drives the read
	 * phase's clock with dummy Tx bytes rather than relying on the
	 * (here, broken) hardware auto-continue -- while staying inside
	 * the same atomic, CS-held write-then-read call exec_op already
	 * provides. See Documentation/arm/ls1024a-wdmycloud.rst for the
	 * full trace-by-trace derivation.
	 */
	snps,dwc-ssi-broken-eeprom-read;

	/*
	 * Likely root cause of the persistent, diagnostic-timeout-proof
	 * hang documented at length in
	 * Documentation/arm/ls1024a-wdmycloud.rst: this block was never
	 * taken out of hardware reset. spi-dw-mmio.c already knows to look
	 * up and deassert an optional reset named "spi"
	 * (devm_reset_control_get_optional_exclusive(&pdev->dev, "spi")) --
	 * it was just never given one. LS1024A_AXI_DUS_RST is the reset
	 * line matching this controller's "dus" clock domain (shared with
	 * uart1, which works without ever needing an explicit reset
	 * deassert -- but a shared clock gate doesn't imply a shared reset
	 * bit, and UART likely has its own separate one, or barebox leaves
	 * it deasserted for its own console use).
	 */
	resets = <&clkreset LS1024A_AXI_DUS_RST>;
	reset-names = "spi";

	/*
	 * Boot/env SPI-NOR flash (also used by barebox itself, per
	 * `devinfo` on real hardware: "c2k_spi0" -> "S25FL064A0", and by
	 * name in barebox's own board file: arch/arm/boards/comcerto-asic/
	 * c2k_asic.c, "S25FL064A", chip_select 0). Spansion/Cypress
	 * S25FL064A, 8 MiB, matches upstream spi-nor's "s25sl064a" entry
	 * (3-byte JEDEC ID 01 02 16, no SFDP/quad support -- an old, plain
	 * chip). Mode (SPI_CPOL | SPI_CPHA, i.e. mode 3) and frequency
	 * (4 MHz) copied directly from that same barebox board file's
	 * spi_board_info entry for this chip.
	 */
	flash@0 {
		compatible = "spansion,s25sl064a", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <4000000>;
		spi-cpha;
		spi-cpol;
	};
};

&hs_spi {
	status = "okay";
};

&i2c {
	status = "okay";
};

/*
 * Not yet ported (Stage 2+):
 *  - PFE (Comcerto Packet Forwarding Engine / eth0): no mainline or
 *    Bonstra/linux-ls1024a driver exists for this block yet. The old
 *    3.2.26 kernel used a custom "pfe" module (see the imported
 *    kmodules/mspd-c2k/pfe sources and firmware blobs in
 *    symops/MCG1-3.2.26) driving EMAC1-3/EGPI/HGPI/BMU/CLASS/TMU/UTIL/HIF.
 *  - RTC (c2k-rtc): proprietary Mindspeed block, no driver in mainline
 *    or in this fork. Board boots with NTP-only timekeeping for now.
 *  - Board LEDs (system_led RGB via GPIO 5/6/7, wifi_led via GPIO 12/13):
 *    the old kernel drove these with direct register pokes
 *    (drivers/leds/leds-wd.c in the 3.2.26 tree), not through
 *    gpio-leds. No LS1024A PWM driver exists yet in this fork, and
 *    the RGB LED combining logic doesn't map cleanly onto plain
 *    gpio-leds. Left out of this DTS rather than describing hardware
 *    with no driver behind it. (This board has no fan.)
 *  - PCIe (pcie0/pcie1, inherited disabled from ls1024a.dtsi): PCIe0
 *    reported "Link Up Failed" in the old kernel's boot log -- nothing
 *    is physically connected on this board.
 */
